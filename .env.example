# Gong API credentials
# Get these from: Gong → Settings → API → Create API Key
GONG_ACCESS_KEY=your-gong-access-key-here
GONG_ACCESS_SECRET=your-gong-access-secret-here

# Salesforce credentials
# SF_SECURITY_TOKEN: Settings → My Personal Information → Reset Security Token
SF_USERNAME=you@ezfacility.com
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-security-token
SF_DOMAIN=login
